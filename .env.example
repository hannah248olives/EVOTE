# Copy this file to .env for local development: cp .env.example .env
# These are development-only values. Never reuse them in production.

POSTGRES_USER=evote
POSTGRES_PASSWORD=evote_dev_password
POSTGRES_DB=evote
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=3001
LOG_LEVEL=info

# Password of the restricted database role the API connects as (evote_app).
# The migrate service sets it; the API logs in with it. Development value only.
EVOTE_APP_PASSWORD=evote_app_dev_password

# Token signing secrets, at least 32 characters each and different from each other.
# Development values only: generate real ones, for example with: openssl rand -base64 48
JWT_SECRET=dev-only-access-secret-change-me-please-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-0123456789

# Each school lives at <school>.<TENANT_BASE_DOMAIN>. Use "localhost" for local development.
TENANT_BASE_DOMAIN=localhost
