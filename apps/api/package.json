{
  "name": "@evote/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "pnpm --filter @evote/database build && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm --filter @evote/database build && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@evote/database": "workspace:*",
    "@fastify/rate-limit": "^11.2.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
